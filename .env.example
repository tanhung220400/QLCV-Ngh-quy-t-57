# Chuỗi kết nối PostgreSQL (Neon / Supabase tự điền khi kết nối với Vercel)
DATABASE_URL=postgres://user:pass@host/db
# Khóa ký phiên đăng nhập, chuỗi ngẫu nhiên dài
AUTH_SECRET=
# Mã dùng một lần để khởi tạo tài khoản quản trị đầu tiên
SETUP_KEY=
# Bảo vệ tác vụ định kỳ (Vercel tự gửi kèm)
CRON_SECRET=
# Vercel Blob để lưu tệp đính kèm (không có thì lưu vào CSDL, tối đa 4 MB/tệp)
BLOB_READ_WRITE_TOKEN=
